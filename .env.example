OPENAI_API_KEY=
OPENAI_SUMMARIZE_MODEL=gpt-4o-mini
OPENAI_RANK_MODEL=gpt-4o-mini
OPENAI_EMAIL_MODEL=gpt-4o-mini

RESEND_API_KEY=
# Verified domain, e.g. Digest <news@yourdomain.com>
RESEND_FROM=

# Direct Postgres URI (port 5432), not the transaction pooler (6543)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

SEC_USER_AGENT=Your Name you@email.com
